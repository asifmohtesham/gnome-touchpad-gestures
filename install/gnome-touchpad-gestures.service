[Unit]
Description=Touchpad gestures: three-finger drag, and on X11 the gestures GNOME lacks there
PartOf=graphical-session.target
# On X11 the daemon does every gesture. On Wayland GNOME has gestures of its
# own, and the daemon does the one it lacks: three-finger drag. The bar
# makes each a condition of which one is enough.
ConditionEnvironment=|XDG_SESSION_TYPE=x11
ConditionEnvironment=|XDG_SESSION_TYPE=wayland
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 -m gnome_touchpad_gestures.daemon
# install.sh copies the program here. %h is the home directory, worked out
# by systemd itself, so nothing about where the repository lives, or what
# its path contains, ends up in this file.
WorkingDirectory=%h/.local/share/gnome-touchpad-gestures
# Python may be told not to look in the working directory (PYTHONSAFEPATH).
Environment=PYTHONPATH=%h/.local/share/gnome-touchpad-gestures
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
