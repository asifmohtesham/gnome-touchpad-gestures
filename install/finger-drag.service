[Unit]
Description=Touchpad gestures: three-finger drag, four-finger swipes, momentum scrolling
PartOf=graphical-session.target
# GNOME on Wayland has gestures of its own, and these would fight them.
ConditionEnvironment=XDG_SESSION_TYPE=x11
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 -m finger_drag.daemon
# install.sh puts the repository's location here.
WorkingDirectory=@REPO@
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
